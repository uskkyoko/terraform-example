# Copy this file to terraform.tfvars and adjust the values.
# terraform.tfvars is read automatically by Terraform and is git-ignored.

# REQUIRED. Use the region you chose in `aws configure` (check: aws configure get region).
# Without this line Terraform asks "var.aws_region  Enter a value:" on every command.
aws_region          = "eu-central-1"
project_name        = "tf-student-demo"
instance_type       = "t3.micro"
# PUBLIC key only (.pub). No key yet?  ssh-keygen -t ed25519
# Using another key? e.g. "~/.ssh/my_key.pub". See README, section "SSH keys".
ssh_public_key_path = "~/.ssh/id_ed25519.pub"

# Find your public IP with:  curl -s ifconfig.me
# ssh_allowed_cidr = "203.0.113.42/32"
ssh_allowed_cidr = "0.0.0.0/0"
