# Terraform state contains resource IDs and may contain secrets. Never commit it.
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# Local variable values (may contain IPs, account-specific settings)
terraform.tfvars
*.auto.tfvars

# Plan files
*.tfplan

# Crash logs
crash.log
crash.*.log
hello.txt

# SSH keys and certificates: never commit, public or private.
# Keys belong in ~/.ssh, not in the project folder.
*.pem
*.key
*.pub
id_rsa*
id_ed25519*
id_ecdsa*
*.ppk
